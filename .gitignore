# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# --- Generated experiment artifacts ---
# The README describes these as outputs of the pipeline, not source:
# probes/representations, completions, evaluations, plots and Optuna studies.
# Representations are ignored by default -- the HFx/HLx activation tensors are ~900MB --
# but the trained probe checkpoints (svm_*.pt / sd_*.pt, ~7.5MB) are committed so the
# team can use them directly without regenerating.
dataset/representations/**
!dataset/representations/*/
!dataset/representations/*/*/
!dataset/representations/*/*/svm_*.pt
!dataset/representations/*/*/sd_*.pt
completions/
runs/

# Regenerable viewer dump (rebuild with experiments/view_completions.py).
# Kept out of the tree because it is a plain-text export of harmful completions.
experiments/results/sweep_*_outputs.txt

# Plain-text model completions (harmful), readable in-editor but kept out of git
# for the same reason as the sweep outputs above.
experiments/results/model_outputs/

# NB: experiments/results/ is otherwise TRACKED on purpose — the analysis
# artifacts (results_full.json, *.png, plot_results.py) are committed results.
# experiments/inspect_logs/*.eval are likewise tracked.

# --- Local tooling / editor ---
code
vscode_cli.tar.gz
.vscode-server/
.DS_Store

# --- Secrets ---
.env
*.pem
